# انسخ هذا الملف باسم .env وعدّل القيم. ملف .env ما ينرفع على GitHub.

# طبقة الذكاء الاصطناعي: none | ollama | openai
LLM_PROVIDER=none
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=30

# لو LLM_PROVIDER=ollama (نموذج محلي)
OLLAMA_URL=http://localhost:11434

# لو LLM_PROVIDER=openai (أي خدمة متوافقة مع OpenAI API، ببيانات وهمية فقط)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# إثراء اختياري لسمعة عناوين IP
ABUSEIPDB_API_KEY=
